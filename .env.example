# Tarigri Surgical MCP Server Configuration

# Log level (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

# Site whose catalog is served (must expose /data.js)
TARIGRI_SITE_ORIGIN=https://tarigrisurgical.com

# How long the fetched catalog is cached, in seconds
CATALOG_CACHE_TTL_SECONDS=900
